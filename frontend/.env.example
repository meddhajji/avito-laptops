# Any PostgreSQL 14+ database. Append ?sslmode=disable for a local container.
DATABASE_URL=postgresql://user:password@host:5432/dbname
GROQ_API_KEY=
# Optional. Salt for the hashed visitor keys used by the chat rate limiter.
RATE_LIMIT_SALT=
# Optional. Public site address for the sitemap; detected automatically on Vercel.
NEXT_PUBLIC_APP_URL=
# Optional, production only: lets Vercel Cron start the nightly pipeline on GitHub Actions.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=
